<mjml>
  <mj-head>
    <mj-title>Reset Your Password</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#334155" line-height="24px" />
      <mj-section padding="20px 0" />
    </mj-attributes>
    <mj-style>
      .footer-link {
        color: #64748b;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section>
      <mj-column>
        <mj-text
          align="center"
          font-size="24px"
          font-weight="700"
          color="#0f172a"
        >
          Shortly
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="8px" padding="40px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700">
          Hello, {{ name }}!
        </mj-text>
        <mj-text>
          We received a request to reset the password for your account. No
          changes have been made yet.
        </mj-text>
        <mj-text>
          Click the button below to choose a new password. **This link will
          expire in 1 hour.**
        </mj-text>

        <mj-button
          background-color="#2563eb"
          color="#ffffff"
          font-weight="700"
          font-size="16px"
          border-radius="6px"
          href="{{resetLink}}"
          padding="25px 0"
        >
          Reset Password
        </mj-button>

        <mj-divider
          border-width="1px"
          border-color="#e2e8f0"
          padding="20px 0"
        />

        <mj-text font-size="14px" color="#64748b">
          If the button above doesn't work, copy and paste this link into your
          browser:
        </mj-text>
        <mj-text font-size="14px">
          <a
            href="{{resetLink}}"
            style="color: #2563eb; word-break: break-all"
            >{{ resetLink }}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8">
          If you did not request a password reset, please ignore this email or
          contact support if you have questions.
        </mj-text>
        <mj-text align="center" font-size="12px" color="#94a3b8">
          © 2026 Shortly Inc.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
