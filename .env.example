# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# API Keys
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM="Your Name <you@yourdomain.com>"

# Frontend
CLIENT_URL=http://localhost:3000

# Security and Authentication
JWT_ACCESS_SECRET="a_strong_jwt_access_secret_of_at_least_32_characters"
JWT_REFRESH_SECRET="a_different_strong_jwt_refresh_secret_of_at_least_32_characters"
SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_MAX_API_REQUESTS=100
RATE_LIMIT_MAX_AUTH_REQUESTS=20
RATE_LIMIT_MAX_PASSRESET_REQUEST=10

# Whitelisted emails for certain actions (optional, comma-separated)
WHITELISTED_EMAILS=
